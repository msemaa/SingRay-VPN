<?xml version="1.0" encoding="utf-8"?>
<Obfuscator>
  <!-- Source protection: symbols are renamed and strings are hidden after
       publish, so shipped binaries cannot be decompiled back into readable
       code. Only CI produces releases; the repository can stay private. -->
  <Var name="InPath" value="obf-in" />
  <Var name="OutPath" value="obf-out" />
  <Var name="KeepPublicApi" value="false" />
  <Var name="HidePrivateApi" value="true" />
  <Var name="HideStrings" value="true" />
  <Var name="RenameProperties" value="true" />
  <Var name="RenameEvents" value="true" />
  <Var name="RenameFields" value="true" />
  <Var name="UseUnicodeNames" value="false" />
  <Var name="ReuseNames" value="true" />
  <Var name="SuppressIldasm" value="true" />

  <Module file="$(InPath)\SingRay.dll" />

  <!-- XAML binds by name at runtime: keep everything the UI reflects on. -->
  <SkipNamespace name="SingRay.Models" />
  <SkipNamespace name="SingRay.ViewModels" />
  <SkipType name="SingRay.App" skipMethods="true" skipFields="true" skipProperties="true" skipEvents="true" />
  <SkipType name="SingRay.MainWindow" skipMethods="true" skipFields="true" skipProperties="true" skipEvents="true" />
</Obfuscator>
