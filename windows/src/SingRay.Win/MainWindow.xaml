<Window x:Class="SingRay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SingRay"
        Height="660" Width="980"
        MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True">
    <!-- No custom chrome: the title bar, close/minimize/maximize buttons,
         snap layouts, Alt+Space menu and taskbar behaviour all come from
         Windows itself, exactly like any other desktop app. -->
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusDetail}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding ProxyEndpoints}" Foreground="{StaticResource MutedBrush}" />
            </StatusBarItem>
        </StatusBar>

        <TabControl Margin="10">
            <!-- Dashboard -->
            <TabItem Header="Dashboard">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="SingRay" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Margin="0,2,0,16" Foreground="{StaticResource MutedBrush}"
                               Text="Multi-protocol client - sing-box and Xray with automatic core switching" />

                    <Border Grid.Row="2" BorderBrush="#22000000" BorderThickness="1" CornerRadius="8" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding StateText}" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding SelectedSummary}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Core: " Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="{Binding ActiveCoreText}" />
                                    <TextBlock Text="   Planned: " Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="{Binding PlannedCore}" />
                                    <TextBlock Text="   Delay: " Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="{Binding DelayText}" />
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{Binding ConnectButtonText}"
                                    Command="{Binding ConnectCommand}"
                                    MinWidth="150" Height="44" FontSize="15" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Import from clipboard" Command="{Binding ImportClipboardCommand}" MinWidth="170" />
                        <Button Content="Test selected" Command="{Binding TestSelectedCommand}" />
                        <Button Content="Update subscriptions" Command="{Binding UpdateSubscriptionsCommand}" MinWidth="160" />
                        <Button Content="Copy proxy for Telegram" Click="OnCopyTelegramProxy" MinWidth="180" />
                    </StackPanel>

                    <TextBlock Grid.Row="4" VerticalAlignment="Bottom" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"
                               Text="Connected is only reported after a real HTTP 204 response travels through the tunnel. If the handshake fails you will see the actual reason instead of a fake green state." />
                </Grid>
            </TabItem>

            <!-- Nodes -->
            <TabItem Header="Nodes">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Import from clipboard" Command="{Binding ImportClipboardCommand}" MinWidth="170" />
                        <Button Content="Add subscription" Click="OnAddSubscription" MinWidth="150" />
                        <Button Content="Test all" Command="{Binding TestAllCommand}" />
                        <Button Content="Delete" Command="{Binding DeleteProfileCommand}" />
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="Auto" />
                            <DataGridTextColumn Header="Transport" Binding="{Binding Network}" Width="Auto" />
                            <DataGridTextColumn Header="Security" Binding="{Binding Security}" Width="Auto" />
                            <DataGridTextColumn Header="Address" Binding="{Binding Endpoint}" Width="2*" />
                            <DataGridTextColumn Header="Delay" Binding="{Binding DelayDisplay}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Settings -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Core" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ComboBox x:Name="CoreBox" SelectionChanged="OnCoreChanged">
                            <ComboBoxItem Content="Auto (recommended)" />
                            <ComboBoxItem Content="sing-box" />
                            <ComboBoxItem Content="Xray" />
                        </ComboBox>
                        <TextBlock x:Name="CoreInfo" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />

                        <TextBlock Text="Tunnel mode" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ComboBox x:Name="TunnelBox" SelectionChanged="OnTunnelChanged">
                            <ComboBoxItem Content="Local proxy only (no system change)" />
                            <ComboBoxItem Content="Windows system proxy (recommended)" />
                            <ComboBoxItem Content="TUN - full device tunnel (needs administrator)" />
                        </ComboBox>

                        <TextBlock Text="Routing" FontWeight="SemiBold" Margin="0,12,0,4" />
                        <ComboBox x:Name="RoutingBox" SelectionChanged="OnRoutingChanged">
                            <ComboBoxItem Content="Rule based" />
                            <ComboBoxItem Content="Global" />
                            <ComboBoxItem Content="Direct" />
                        </ComboBox>

                        <CheckBox x:Name="BypassLanBox" Content="Bypass LAN and private addresses" Margin="0,12,0,0" />
                        <CheckBox x:Name="BypassDomesticBox" Content="Bypass domestic traffic" />
                        <CheckBox x:Name="CloseToTrayBox" Content="Closing the window keeps SingRay running in the notification area" />
                        <CheckBox x:Name="StartMinimizedBox" Content="Start minimized to the notification area" />
                        <CheckBox x:Name="StartupBox" Content="Launch SingRay when I sign in" />
                        <CheckBox x:Name="AutoClipboardBox" Content="Import clipboard contents directly, without a paste dialog" />

                        <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Logs -->
            <TabItem Header="Logs">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Clear" Command="{Binding ClearLogCommand}" />
                        <Button Content="Copy all" Click="OnCopyLogs" />
                        <Button Content="Open data folder" Click="OnOpenDataFolder" MinWidth="140" />
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="12"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- About -->
            <TabItem Header="About">
                <StackPanel Margin="24">
                    <TextBlock Text="SingRay for Windows" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Windows 10 (1809+) and Windows 11, x64 / x86 / ARM64. Uses the official sing-box and Xray cores bundled next to the executable." />
                    <TextBlock x:Name="VersionText" Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
