<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The platform version must be part of the TFM, otherwise the SDK
         infers TargetPlatformVersion 7.0 and rejects SupportedOSPlatformVersion. -->
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms> <!-- only for the tray icon -->
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SingRay</AssemblyName>
    <RootNamespace>SingRay</RootNamespace>
    <ApplicationIcon Condition="Exists('Assets\app.ico')">Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Windows 10 1809+ / Windows 11, x64 + x86 + arm64 -->
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>

    <!-- Source protection: single self-contained binary, no PDBs shipped. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- ReadyToRun cannot be cross-compiled for arm64 from an x64 runner. -->
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != 'win-arm64'">true</PublishReadyToRun>
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Deterministic>true</Deterministic>

    <Version>1.0.0</Version>
    <Company>SingRay</Company>
    <Product>SingRay</Product>
    <AssemblyTitle>SingRay</AssemblyTitle>
  </PropertyGroup>

  <!-- WPF and WinForms are both referenced (WinForms only for the tray icon),
       so these type names exist twice. Pin them to the WPF versions globally
       instead of fully qualifying every call site. -->
  <ItemGroup>
    <Using Include="System.Windows.Application" Alias="Application" />
    <Using Include="System.Windows.MessageBox" Alias="MessageBox" />
    <Using Include="System.Windows.Clipboard" Alias="Clipboard" />
  </ItemGroup>

  <!-- Native cores are placed here by CI before publish (see the workflow).
       sing-box.exe / xray.exe are launched as child processes by path, so they
       must stay real files on disk next to SingRay.exe. Without
       ExcludeFromSingleFile they would be bundled inside the single-file host
       and publish/<arch>/cores would come out empty. The glob simply matches
       nothing when the folder is absent, so no condition is needed. -->
  <ItemGroup>
    <Content Include="cores\**\*">
      <Link>cores\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="Assets\**\*">
      <Link>Assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

</Project>
