<Application x:Class="SingRay.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Deliberately close to the Windows 11 system palette so the app
                 feels native. No custom window chrome anywhere. -->
            <SolidColorBrush x:Key="AccentBrush" Color="#FF0F6CBD" />
            <SolidColorBrush x:Key="OkBrush" Color="#FF107C10" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#FFC42B1C" />
            <SolidColorBrush x:Key="MutedBrush" Color="#FF6B6B6B" />

            <Style TargetType="Button">
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="MinWidth" Value="96" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Margin" Value="0,6,0,6" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="MinWidth" Value="180" />
                <Setter Property="Margin" Value="0,4,0,4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
